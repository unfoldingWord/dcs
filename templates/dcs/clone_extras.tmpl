{{/* Expects RepoDM, RepoLink and RefFullName in the dict passed to repo/clone_panel (templates/repo/view_content.tmpl) */}}
{{if and .RepoDM .RefFullName .RepoDM.CanConvertToSB}}
	<a class="item muted archive-link" href="{{.RepoLink}}/sb/{{PathEscapeSegments .RefFullName.ShortName}}.zip" rel="nofollow">{{svg "octicon-file-zip"}} {{ctx.Locale.Tr "dcs.repo.download_zip_sb"}}</a>
	<a class="item muted archive-link" href="{{.RepoLink}}/sb/{{PathEscapeSegments .RefFullName.ShortName}}.tar.gz" rel="nofollow">{{svg "octicon-file-zip"}} {{ctx.Locale.Tr "dcs.repo.download_tar_sb"}}</a>
{{end}}
