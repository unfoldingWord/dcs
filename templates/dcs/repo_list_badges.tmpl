{{if .RepoDM}}
	{{if gt .RepoDM.ID 0}}
		{{template "shared/healthcheck_badge" (dict
			"RepoLink" .Link
			"Severity" .RepoDM.HealthcheckSeverity
			"OwnerName" .OwnerName
			"RepoName" .Name
			"Ref" .RepoDM.Ref
		)}}
	{{end}}
	{{if .LatestProdDM}}
		<a class="ui green label compact icon button" href="{{.Link}}/releases/tag/{{.LatestProdDM.Ref | PathEscapeSegments}}" rel="nofollow" data-tooltip-content="Catalog: Production" aria-label="Catalog: Production">
			{{.LatestProdDM.Ref}}
		</a>
	{{end}}
	{{if .LatestPreprodDM}}
		<a class="ui orange label compact icon button" href="{{.Link}}/releases/tag/{{.LatestPreprodDM.Ref | PathEscapeSegments}}" rel="nofollow" data-tooltip-content="Catalog: Pre-Production" aria-label="Catalog: Pre-Production">
			{{.LatestPreprodDM.Ref}}
		</a>
	{{end}}
{{end}}
