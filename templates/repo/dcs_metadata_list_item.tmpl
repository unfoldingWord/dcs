{{$dm := .Door43Metadata}}
{{if $dm}}
<div class="item">
	<div class="flex-text-block tw-justify-between">
		<div class="flex-text-inline">
			{{$color := "grey"}}
			{{$type := $dm.RefType}}
			{{$icon := ""}}
			{{if eq $dm.RefType "branch"}}
				{{$icon = "octicon-git-branch"}}
			{{else}}
				{{$icon = "octicon-tag"}}
			{{end}}
			{{$tooltip := "Stage: other"}}

			{{if eq $dm.Stage 1}}
				{{$color = "green"}}
				{{$tooltip = "Stage: prod - Production Release"}}
			{{else if eq $dm.Stage 2}}
				{{$color = "orange"}}
				{{$tooltip = "Stage: preprod - Pre-Release"}}
			{{else if eq $dm.Stage 3}}
				{{$color = "purple"}}
				{{$tooltip = "Stage: latest - Default Branch / Metadata"}}
			{{else if and (eq $dm.Stage 4) (.IsRepoMetadata)}}
				{{$color = "cyan"}}
				{{$tooltip = "Stage: other; Default Metadata"}}
			{{end}}

			{{if $dm.ValidationError}}
				{{$color = "red"}}
				{{$tooltip = printf "%s; INVALID" $tooltip}}
			{{else if and $dm.IsLatestForStage (lt $dm.Stage 3)}}
				{{$tooltip = printf "%s; Latest" $tooltip}}
			{{end}}
			<a data-tooltip-content="{{$type}}" href="{{.ctxData.RepoLink}}/src/{{$dm.RefType}}/{{PathEscapeSegments $dm.Ref}}">{{svg $icon 16 "tw-mr-2"}}</a>
			<span data-tooltip-content="{{$tooltip}}" class="text {{$color}} tw-mr-2">{{svg "octicon-dot-fill" 22}}</span>
			<a class="ui primary sha label toggle button show-panel" data-panel="#info-{{$dm.ID}}">{{$dm.Ref}}</a>
		</div>
		<span class="text grey">
			{{DateUtils.TimeSince $dm.ReleaseDateUnix}}
		</span>
	</div>
	<div class="info tw-hidden" id="info-{{$dm.ID}}">
		<div class="ui top attached tabular menu">
			<a class="item active" data-tab="db-{{$dm.ID}}">
				Metadata (DB)
			</a>
			<a class="item" data-tab="json-{{$dm.ID}}">
				Metadata (JSON)
			</a>
			{{if $dm.ValidationError}}
			<a class="item" data-tab="validation-errors-{{$dm.ID}}">
				Validation Errors (JSON)
			</a>
			{{end}}
			<a class="item"
				href="{{Door43PreviewURL}}/u/{{PathEscapeSegments .ctxData.Repository.OwnerName}}/{{PathEscapeSegments .ctxData.Repository.Name}}/{{PathEscapeSegments $dm.Ref}}{{if eq AppUrl "https://qa.door43.org/"}}?server=QA{{end}}{{if eq AppUrl "https://develop.door43.org/"}}?server=DEV{{end}}"
				target="_blank" rel="nofollow noopener">
				{{ctx.Locale.Tr "preview"}} / PDF
			</a>
		</div>
		<div class="ui bottom attached tab segment active" data-tab="db-{{$dm.ID}}">
			<table class="tw-mb-4">
				{{if $dm.ValidationError}}
				<tr>
					<td colspan="2">
						<div class="ui negative message tw-p-2">
							INVALID <a href="{{.ctxData.RepoLink}}/src/{{$dm.RefType}}/{{PathEscapeSegments $dm.Ref}}/{{$dm.MetadataFilename}}">{{$dm.MetadataFilename}}</a> FILE
						</div>
					</td>
				</tr>
				{{end}}
				<tr>
					<td class="tw-align-top"><strong>{{ctx.Locale.Tr "dcs.repo.metadata.title"}}:</strong></td>
					<td class="tw-align-top">{{$dm.Title}}</td>
				</tr>
				<tr>
					<td class="tw-align-top"><strong>{{ctx.Locale.Tr "dcs.repo.metadata.publisher"}}:</strong></td>
					<td class="tw-align-top">{{$dm.Publisher}}</td>
				</tr>
				<tr>
					<td class="tw-align-top"><strong>{{ctx.Locale.Tr "dcs.repo.metadata.abbreviation"}}:</strong>
					</td>
					<td class="tw-align-top">{{$dm.Abbreviation}}</td>
				</tr>
				<tr>
					<td class="tw-align-top"><strong>{{ctx.Locale.Tr "dcs.repo.metadata.subject"}}:</strong></td>
					<td class="tw-align-top">{{$dm.Subject}}</td>
				</tr>
				<tr>
					<td class="tw-align-top"><strong>{{ctx.Locale.Tr "dcs.repo.metadata.flavor_type"}}:</strong></td>
					<td class="tw-align-top">{{$dm.FlavorType}}</td>
				</tr>
				<tr>
					<td class="tw-align-top"><strong>{{ctx.Locale.Tr "dcs.repo.metadata.flavor"}}:</strong></td>
					<td class="tw-align-top">{{$dm.Flavor}}</td>
				</tr>
				<tr>
					<td class="tw-align-top"><strong>{{ctx.Locale.Tr "dcs.repo.metadata.metadata_type"}}:</strong>
					</td>
					<td class="tw-align-top"><img src="{{AssetUrlPrefix}}/img/dcs/{{$dm.MetadataTypeIcon}}" height="16" class="tw-align-middle" /> {{$dm.MetadataTypeTitle}} ({{$dm.MetadataType}}
						{{$dm.MetadataVersion}})</td>
				</tr>
				<tr>
					<td class="tw-align-top"><strong>{{ctx.Locale.Tr "dcs.repo.metadata.language"}}:</strong></td>
					<td class="tw-align-top">{{$dm.LanguageTitle}} ({{$dm.Language}}, {{$dm.LanguageDirection}})</td>
				</tr>
				<tr>
					<td class="tw-align-top"><strong>{{ctx.Locale.Tr "dcs.repo.metadata.ingredients"}}:</strong></td>
					<td class="tw-align-top">
						<button type="button" class="ui button dcs-toggle-table" aria-controls="ingredients-{{$dm.ID}}" aria-expanded="false"
							data-expand-text="{{ctx.Locale.Tr "dcs.repo.metadata.show_ingredients"}}" data-collapse-text="{{ctx.Locale.Tr "dcs.repo.metadata.hide_ingredients"}}">
							{{ctx.Locale.Tr "dcs.repo.metadata.show_ingredients"}}
						</button>
						<table id="ingredients-{{$dm.ID}}" class="ui celled table full-width tw-hidden tw-p-2">
							<thead>
								<tr>
									<th>ID</th>
									<th>Title</th>
									<th>Path</th>
									<th>Size</th>
								</tr>
							</thead>
							<tbody>
								{{range $dm.Ingredients}}
								<tr>
									<td>
										{{.Identifier}}
									</td>
									<td>
										{{.Title}}
									</td>
									<td>
										{{.Path}}
									</td>
									<td>
										{{if not .Exists}}
						<span class="ui red label">{{ctx.Locale.Tr "dcs.repo.metadata.missing"}}</span>
										{{else if .IsDir}}
										(Dir)
										{{else}}
										{{FormatByteSize .Size}}
										{{end}}
									</td>
								</tr>
								{{end}}
							</tbody>
						</table>
					</td>
				</tr>
				<tr>
					<td class="tw-align-top"><strong>{{ctx.Locale.Tr "dcs.repo.metadata.relations"}}:</strong></td>
					<td class="tw-align-top">
						<button type="button" class="ui button dcs-toggle-table" aria-controls="relations-{{$dm.ID}}" aria-expanded="false"
							data-expand-text="{{ctx.Locale.Tr "dcs.repo.metadata.show_relations"}}" data-collapse-text="{{ctx.Locale.Tr "dcs.repo.metadata.hide_relations"}}">
							{{ctx.Locale.Tr "dcs.repo.metadata.show_relations"}}
						</button>
						<table id="relations-{{$dm.ID}}" class="ui celled table full-width tw-hidden tw-p-2">
							<thead>
								<tr>
									<th>Language</th>
									<th>Resource</th>
									<th>Version</th>
								</tr>
							</thead>
							<tbody>
								{{range $dm.Relations}}
								<tr>
									<td>{{.Language}}</td>
									<td>{{.Identifier}}</td>
									<td>{{.Version}}</td>
								</tr>
								{{end}}
							</tbody>
						</table>
					</td>
				</tr>
				<tr>
					<td class="tw-align-top"><strong>{{ctx.Locale.Tr "dcs.repo.metadata.content_format"}}:</strong>
					</td>
					<td class="tw-align-top">{{$dm.ContentFormat}}</td>
				</tr>
				<tr>
					<td class="tw-align-top"><strong>{{ctx.Locale.Tr "dcs.repo.metadata.stage"}}:</strong></td>
					<td class="tw-align-top">{{$dm.StageStr}}</td>
				</tr>
				<tr>
					<td class="tw-align-top"><strong>SHA:</strong></td>
					<td class="tw-align-top">{{$dm.CommitSHA}}</td>
				</tr>
				<tr>
					<td class="tw-align-top"><strong>{{if $dm.Release}}{{ctx.Locale.Tr
							"dcs.repo.metadata.release_date"}}{{else}}{{ctx.Locale.Tr
							"dcs.repo.metadata.last_updated"}}{{end}}:</strong></td>
					<td class="tw-align-top">{{DateUtils.AbsoluteLong $dm.ReleaseDateUnix}}</td>
				</tr>
				{{if gt $dm.ID 0}}
				<tr>
					<td class="tw-align-top"><strong>{{ctx.Locale.Tr "dcs.repo.metadata.healthcheck"}}:</strong></td>
					<td class="tw-align-top">
						<button type="button" class="ui button dcs-toggle-table" aria-controls="healthcheck-{{$dm.ID}}" aria-expanded="false"
							data-expand-text="{{ctx.Locale.Tr "dcs.repo.metadata.show_healthcheck"}}" data-collapse-text="{{ctx.Locale.Tr "dcs.repo.metadata.hide_healthcheck"}}">
							{{ctx.Locale.Tr "dcs.repo.metadata.show_healthcheck"}}
						</button>
						<div id="healthcheck-{{$dm.ID}}" class="tw-hidden">
							{{template "repo/dcs_healthcheck_list" (dict "ctxData" .ctxData "Door43Metadata" $dm)}}
						</div>
					</td>
				</tr>
				{{end}}
			</table>
		</div>
		<div class="ui bottom attached tab segment" data-tab="json-{{$dm.ID}}">
			<pre class="tw-whitespace-pre-wrap tw-break-words">{{$dm.MetadataJSONString}}</pre>
		</div>
		{{if $dm.ValidationError}}
		<div class="ui bottom attached tab segment" data-tab="validation-errors-{{$dm.ID}}">
			<pre class="tw-whitespace-pre-wrap tw-break-words">{{$dm.ValidationErrorJSONString}}</pre>
		</div>
		{{end}}
	</div>
</div>
{{end}}
