{{template "base/head" .}}
<script>
	function toggleShowTable(element, type) {
		var content = element.parentElement.nextElementSibling;
		if (content.style.display === "none") {
			content.style.display = "table";
			element.innerText = "Click to collapse "+type;
		} else {
			content.style.display = "none";
			element.innerText = "Click to see "+type;
		}
	}
</script>
<style>
	.status-item {
			padding: 10px;
			margin-bottom: 10px;
			border-radius: 5px;
			border: 2px solid;
	}
	.status-item.error {
			background-color: #ffcccc; /* Light red background */
			border-color: #cc0000; /* Dark red border */
	}
	.status-item.warning {
			background-color: #ffebcc; /* Light orange background */
			border-color: #cc7a00; /* Dark orange border */
	}
	.status-item.info {
			background-color: #cce5ff; /* Light blue background */
			border-color: #004085; /* Dark blue border */
	}
	.status-item.success {
			background-color: #d4edda; /* Light green background */
			border-color: #155724; /* Dark green border */
	}

	.item-text {
			padding-left: 20px;
			margin-top: 10px;
	}
</style>
<div role="main" aria-label="{{.Title}}" class="page-content repository settings">
	{{template "repo/header" .}}
	{{template "base/alert" .}}
	<div class="ui container">
		<h2 class="ui header metadata-header">
			{{ctx.Locale.Tr "repo.metadata.healthcheck"}} {{svg "octicon-shield-check"}}
		</h2>
		<div class="repo-metadata-content">
			<h4 class="ui top attached header">
				Overall {{.Title}}
			</h4>
			<div class="ui attached segment">
				<div class="ui list">
					{{if .Healthcheck}}
						{{range $issueCode := .Healthcheck.GetOrder}}
							{{$issues := index $.Healthcheck.Issues $issueCode}}							
							<div class="ui item">
								<div class="toggle show-panel" data-panel="#{{$issueCode}}">
								{{if not $issues}}
									<span style="color: green;">&#10003;</span>
								{{else}}
									<span style="color: red;">&#10007;</span>
								{{end}}
								{{$issueCode.IssuePositiveString}}
								</div>
								{{if $issues}}
									<div class="ui list gt-hidden" id="{{$issueCode}}">
										{{range $issue := $issues}}
											<div class="status-item {{$issue.SeverityLevel}}">
												<div class="item-text">
													{{RenderMarkdownToHtml $.Contenxt $issue.Details}}
												</div>
												<div class="item-text">
													{{RenderMarkdownToHtml $.Context $issue.Suggestion}}
												</div>
											</div>
										{{end}}
									</div>
								{{end}}
							</div>
						{{end}}
					{{end}}
				</div>
		</div>

			<h4 class="ui top attached header">
				{{ctx.Locale.Tr "repo.metadata.metadata"}}
				{{if .Permission.IsAdmin}}
				<div class="ui right">
					<a class="ui teal tiny button" href="{{.Link}}/update">Update Metadata</a>
				</div>
				{{end}}
			</h4>
			<div class="ui attached segment">
					{{if or .BranchDMs .ReleaseDMs}}
						<h3 class="ui top attached header toggle show-panel" data-panel="#branches">{{ctx.Locale.Tr "repo.branches"}}</h3>
						<div class="ui attached segment gt-hidden" id="branches">
							{{template "repo/dcs_metadata_list" (dict "ctxData" . "Door43Metadatas" .BranchDMs)}}
						</div>
						<h3 class="ui top attached header toggle show-panel" data-panel="#releases">Releases</h3>
						<div class="ui attached segment gt-hidden" id="releases">
							{{template "repo/dcs_metadata_list" (dict "ctxData" . "Door43Metadatas" .ReleaseDMs)}}
						</div>
					{{else}}
						<span>
							No Metadata for this Repository. Click&nbsp;<a href="{{.Link}}/update">update</a>&nbsp;to scan the repo.
						</span>
					{{end}}
			</div>
		</div>
	</div>
</div>
{{template "base/footer" .}}