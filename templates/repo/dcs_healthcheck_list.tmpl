{{if .Door43Metadata}}
  {{$healthcheck := .Door43Metadata.GetHealthcheck ctx}}
	<div class="ui list">
	{{range $issueCode := $healthcheck.GetOrder}}
		{{$issues := index $healthcheck.Issues $issueCode}}							
		<div class="ui item">
			<div class="toggle show-panel" data-panel="#{{$issueCode}}">
			{{if not $issues}}
				<span style="color: green;">{{svg "octicon-check-circle-fill" 16}}</span>
			{{else}}
				{{if eq ((index $issues 0).SeverityLevel.String) "error"}}
					<span style="color: red;">{{svg "octicon-x-circle-fill" 16}}</span>
				{{else if eq ((index $issues 0).SeverityLevel.String) "warning"}}
					<span style="color: orange;">{{svg "octicon-stop" 16}}</span>
				{{else if eq ((index $issues 0).SeverityLevel.String) "info"}}
					<span style="color: blue;">{{svg "octicon-info" 16}}</span>
				{{end}}
			{{end}}
			{{$issueCode.IssuePositiveString}}
			</div>
			{{if $issues}}
				<div class="ui list gt-hidden" id="{{$issueCode}}">
					{{range $issue := $issues}}
						<div class="status-item {{$issue.SeverityLevel}}">
							<div class="item-text">
								{{RenderMarkdownToHtml $.Context $issue.Details}}
							</div>
							{{if eq .Door43Metadata.RefType "branch"}}
								<div class="item-text">
									{{RenderMarkdownToHtml $.Context $issue.Suggestion}}
								</div>
							{{end}}
						</div>
					{{end}}
				</div>
			{{end}}
		</div>
	{{end}}
  </div>
{{end}}

