{{template "base/head" .}}
<style>
	.status-item {
		padding: 10px;
		margin-bottom: 10px;
		border-radius: 5px;
		border: 2px solid;
		color: var(--color-black);
	}
	.show-panel {
		cursor: pointer;
	}
	.status-item.error {
		background-color: #ffcccc;
		border-color: #cc0000;
	}
	.status-item.warning {
		background-color: #ffebcc;
		border-color: #cc7a00;
	}
	.status-item.info {
		background-color: #cce5ff;
		border-color: #004085;
	}
	.status-item.success {
		background-color: #d4edda;
		border-color: #155724;
	}
	.item-text {
		padding-left: 20px;
		margin-top: 10px;
	}
</style>
<div role="main" aria-label="{{.Title}}" class="page-content repository settings">
	{{template "repo/header" .}}
	{{template "base/alert" .}}
	<div class="ui container">
		<a href="{{.RepoLink}}/metadata" class="ui back link">
			{{svg "octicon-arrow-left" 16}}
			{{ctx.Locale.Tr "dcs.repo.metadata.back_to_metadata"}}
		</a>
		<h2 class="ui top attached header">
			{{ctx.Locale.Tr "dcs.repo.metadata.all_branches_releases_metadata"}}
			{{if .Permission.IsAdmin}}
			<div class="ui right">
				<a class="ui teal tiny button" href="{{.RepoLink}}/metadata/update">{{ctx.Locale.Tr "dcs.repo.metadata.update_metadata"}}</a>
			</div>
			{{end}}
		</h2>
		<div class="ui attached segment">
			{{if or .BranchDMs .ReleaseDMs}}
				<h3 class="ui top attached header toggle show-panel" data-panel="#branches">{{ctx.Locale.Tr "repo.branches"}} ({{len .BranchDMs}})</h3>
				<div class="ui attached segment tw-hidden" id="branches">
					{{if .BranchDMs}}
						{{template "repo/dcs_metadata_list" (dict "ctxData" . "Door43Metadatas" .BranchDMs "IsRC" .IsRC)}}
					{{else}}
						<span>No branch metadata found.</span>
					{{end}}
				</div>
				<h3 class="ui top attached header">{{ctx.Locale.Tr "dcs.repo.metadata.releases"}} ({{.ReleaseCount}})</h3>
				<div class="ui attached segment" id="releases">
					{{if .ReleaseDMs}}
						{{template "repo/dcs_metadata_list" (dict "ctxData" . "Door43Metadatas" .ReleaseDMs "IsRC" .IsRC)}}
						{{template "base/paginate" .}}
					{{else}}
						<span>No release metadata found.</span>
					{{end}}
				</div>
			{{else}}
				<span>
					No Metadata for this Repository. Click&nbsp;<a href="{{.RepoLink}}/metadata/update">update</a>&nbsp;to scan the repo.
				</span>
			{{end}}
		</div>
	</div>
</div>
{{template "base/footer" .}}
