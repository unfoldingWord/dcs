{{template "base/head" .}}
<style>
	.status-item {
		padding: 10px;
		margin-bottom: 10px;
		border-radius: 5px;
		border: 2px solid;
		color: var(--color-black);
	}
	.show-panel {
		cursor: pointer;
	}
	.status-item.error {
		background-color: #ffcccc;
		border-color: #cc0000;
	}
	.status-item.warning {
		background-color: #ffebcc;
		border-color: #cc7a00;
	}
	.status-item.info {
		background-color: #cce5ff;
		border-color: #004085;
	}
	.status-item.success {
		background-color: #d4edda;
		border-color: #155724;
	}
	.item-text {
		padding-left: 20px;
		margin-top: 10px;
	}
</style>
<div role="main" aria-label="{{.Title}}" class="page-content repository settings">
	{{template "repo/header" .}}
	{{template "base/alert" .}}
	<div class="ui container">
		<h2 class="ui header metadata-header">
			{{ctx.Locale.Tr "dcs.repo.metadata.metadata"}} {{svg "octicon-file-badge"}}
		</h2>
		<div class="repo-metadata-content">
			<h4 class="ui top attached header">
				{{ctx.Locale.Tr "dcs.repo.metadata.default_branch_and_latest_release"}}
				<div class="ui right">
					<a class="ui teal tiny button" href="{{.RepoLink}}/metadata/all">{{ctx.Locale.Tr "dcs.repo.metadata.see_all_branches_releases"}}</a>
					{{if .Permission.IsAdmin}}
						<a class="ui teal tiny button" href="{{.RepoLink}}/metadata/update">{{ctx.Locale.Tr "dcs.repo.metadata.update_metadata"}}</a>
					{{end}}
				</div>
			</h4>
			<div class="ui attached segment">
				{{if .Door43Metadatas}}
					{{template "repo/dcs_metadata_list" (dict "ctxData" . "Door43Metadatas" .Door43Metadatas "IsRC" .IsRC)}}
				{{else}}
					<span>
						No Metadata for this Repository. Click&nbsp;<a href="{{.RepoLink}}/metadata/update">update</a>&nbsp;to scan the repo.
					</span>
				{{end}}
			</div>
		</div>
	</div>
</div>
{{template "base/footer" .}}
