<div class="flex-divided-list items-with-main">
	{{range .Door43Metadatas}}
		<div class="item">
			<div class="item-leading">
				{{template "repo/icon" .Repo}}
			</div>
			<div class="item-main">
				<div class="item-header">
					<div class="item-title">
						<a class="tw-text-primary name" href="{{.Repo.Link}}/{{if .Release}}releases/tag{{else}}src/branch{{end}}/{{.Ref | PathEscapeSegments}}" data-tooltip-content="{{ctx.Locale.Tr "dcs.repo.metadata.abbreviation"}}: {{.Abbreviation}}">
							{{.Title}}
						</a>
						<span class="label-list">
							{{if .Repo.IsFork}}
								<span class="middle">{{svg "octicon-repo-forked" 16}}</span>
							{{else if .Repo.IsMirror}}
								<span class="middle">{{svg "octicon-repo-clone" 16}}</span>
							{{end}}
							{{if eq .MetadataType "rc"}}
								{{template "shared/healthcheck_badge" (dict
									"RepoLink" .Repo.Link
									"Severity" .HealthcheckSeverity
									"OwnerName" .Repo.OwnerName
									"RepoName" .Repo.Name
									"Ref" .Ref
								)}}
							{{end}}
							{{if .Release}}
								{{$color := "green"}}
								{{$type := "Production"}}
								{{if .Release.IsPrerelease}}
									{{$color = "orange"}}
									{{$type = "Pre-Release"}}
								{{end}}
								<a href="{{.Release.HTMLURL}}" rel="nofollow" style="opacity: inherit !important; margin: 0">
									<button class="ui {{$color}} label compact icon button" data-tooltip-content="Catalog: {{$type}}" aria-label="Catalog: {{$type}}">
										{{.Ref}}
									</button>
								</a>
							{{end}}
						</span>
					</div>
					<div class="item-trailing">
						<a class="muted flex-text-inline" href="{{$.Link}}?sort={{$.SortType}}&q=lang%3A{{.Language}}" data-tooltip-content="{{ctx.Locale.Tr "dcs.repo.metadata.language"}}: {{.LanguageTitle}} ({{.Language}}, {{.LanguageDirection}})">
							<i class="color-icon" style="background-color: {{GetColorFromString .Language}}"></i>{{.Language}}
						</a>
						<a class="muted flex-text-inline" href="{{$.Link}}?sort={{$.SortType}}&q=subject%3A{{.Subject}}">
							<i class="color-icon" style="background-color: {{GetColorFromString .Subject}}"></i>{{.Subject}}
						</a>
						<a class="muted flex-text-inline" href="?sort={{$.SortType}}&q=metadata_type%3A{{.MetadataType}}" data-tooltip-content="{{ctx.Locale.Tr "dcs.repo.metadata.metadata_type"}}: {{.MetadataTypeTitle}} ({{.MetadataType}} {{.MetadataVersion}})">
							<img src="{{AssetUrlPrefix}}/img/dcs/{{.MetadataTypeIcon}}" style="height:16px;vertical-align:middle">
							{{.MetadataType}} {{.MetadataVersion}}
						</a>
						{{if not $.DisableStars}}
							<a class="flex-text-inline" href="{{.Repo.Link}}/stars">
								<span class="tw-contents" aria-label="{{ctx.Locale.Tr "repo.stars"}}">{{svg "octicon-star" 16}}</span>
								<span {{if ge .Repo.NumStars 1000}}data-tooltip-content="{{.Repo.NumStars}}"{{end}}>{{CountFmt .Repo.NumStars}}</span>
							</a>
						{{end}}
						<a class="flex-text-inline" href="{{.Repo.Link}}/forks">
							<span class="tw-contents" aria-label="{{ctx.Locale.Tr "repo.forks"}}">{{svg "octicon-git-branch" 16}}</span>
							<span {{if ge .Repo.NumForks 1000}}data-tooltip-content="{{.Repo.NumForks}}"{{end}}>{{CountFmt .Repo.NumForks}}</span>
						</a>
						<a class="flex-text-inline" href="{{.Repo.Link}}/releases" data-tooltip-content="# of releases">
							<span class="tw-contents">{{svg "octicon-tag" 16}}</span>
							<span>{{.ReleaseCount ctx}}</span>
						</a>
					</div>
				</div>
				<div class="item-body">
					{{ctx.Locale.Tr "dcs.repo.metadata.publisher"}}:
					<a href="?sort={{$.SortType}}&q=owner%3A{{.Repo.OwnerName}}">
						{{if $.Publisher}}{{$.Publisher}}{{else if .Repo.Owner.FullName}}{{.Repo.Owner.FullName}}{{else}}{{.Repo.OwnerName}}{{end}}
					</a>
				</div>
				{{if .Repo.Topics}}
					<div class="label-list">
						{{range .Repo.Topics}}
							{{if ne . ""}}<a class="ui label" href="{{AppSubUrl}}/catalog?q=topic%3A{{.}}">{{.}}</a>{{end}}
						{{end}}
					</div>
				{{end}}
				<div class="item-body">{{if .Release}}{{ctx.Locale.Tr "dcs.explore.released"}}{{else}}{{ctx.Locale.Tr "org.repo_updated"}}{{end}} {{DateUtils.TimeSince .ReleaseDateUnix}}</div>
			</div>
		</div>
	{{else}}
	<div>
		{{ctx.Locale.Tr "search.no_results"}}
	</div>
	{{end}}
</div>
