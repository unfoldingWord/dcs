{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content explore catalog repositories">
	<div class="ui container">
		<h2 class="ui header">{{.Title}}</h2>

		<form id="hc-dash-form" class="ui form tw-mb-4" method="get">
			<input type="hidden" name="filters_applied" value="1">
			<div class="fields stackable">
				<div class="ten wide field">
					<label>Search</label>
					<div class="ui action input tw-w-full">
						<input type="text" name="q" value="{{.Keyword}}" placeholder="Search by owner, repo, or subject">
						<button class="ui button" type="submit">{{ctx.Locale.Tr "search.search"}}</button>
					</div>
				</div>
				<div class="six wide field">
					<label class="tw-invisible">Filters</label>
					<div class="tw-flex tw-flex-wrap tw-gap-3 tw-justify-end tw-items-center">
						<select class="ui dropdown js-hc-dash-autosubmit" name="metadata_type">
							<option value="">All metadata types</option>
							<option value="rc" {{if eq .MetadataType "rc"}}selected{{end}}>rc</option>
							<option value="sb" {{if eq .MetadataType "sb"}}selected{{end}}>sb</option>
							<option value="tc" {{if eq .MetadataType "tc"}}selected{{end}}>tc</option>
							<option value="ts" {{if eq .MetadataType "ts"}}selected{{end}}>ts</option>
						</select>
						<div class="ui checkbox">
							<input class="js-hc-dash-autosubmit" type="checkbox" name="tc_ready" value="1" {{if .TCReadyOnly}}checked{{end}}>
							<label>Filter by tc-ready topic</label>
						</div>
						<div class="ui checkbox">
							<input class="js-hc-dash-autosubmit" type="checkbox" name="failed_only" value="1" {{if .FailedOnly}}checked{{end}}>
							<label>Show only failed health checks</label>
						</div>
					</div>
				</div>
			</div>
		</form>

		<div class="tw-text-text-light-2 tw-mb-3">Total: {{.Total}}</div>
		<div class="divider"></div>

		<div class="flex-divided-list items-with-main">
			{{range .Door43Metadatas}}
				<div class="item">
					<div class="item-leading">
						{{template "shared/healthcheck_badge" (dict
							"RepoLink" .Repo.Link
							"Severity" .HealthcheckSeverity
							"OwnerName" .Repo.OwnerName
							"RepoName" .Repo.Name
							"Ref" .Ref
						)}}
					</div>
					<div class="item-main">
						<div class="item-header">
							<div class="item-title">
								<a class="muted" href="{{.Repo.Owner.HomeLink}}">{{.Repo.OwnerName}}</a>/<a class="muted" href="{{.Repo.Link}}">{{.Repo.Name}}</a>
								{{if .Ref}}<a class="ui basic label" href="{{.Repo.Link}}/releases/tag/{{.Ref | PathEscapeSegments}}">{{.Ref}}</a>{{end}}
							</div>
						</div>
						<div class="item-body">Subject: {{.Subject}} ({{.MetadataType}})</div>
						<div class="item-body">{{ctx.Locale.Tr "dcs.explore.released"}} {{DateUtils.TimeSince .ReleaseDateUnix}}</div>
					</div>
				</div>
			{{else}}
				<div>{{ctx.Locale.Tr "search.no_results"}}</div>
			{{end}}
		</div>

		{{template "base/paginate" .}}
	</div>
</div>
{{template "base/footer" .}}
