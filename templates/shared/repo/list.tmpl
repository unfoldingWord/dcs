<div class="flex-list">
	{{range .Repos}}
		<div class="flex-item">
			<div class="flex-item-leading">
				{{if $.ShowRepoOwnerAvatar}}
					{{ctx.AvatarUtils.Avatar .Owner 24}}
				{{else}}
					{{template "repo/icon" .}}
				{{end}}
			</div>
			<div class="flex-item-main">
				<div class="flex-item-header">
					<div class="flex-item-title">
						{{if and $.ShowRepoOwnerOnList .Owner}}
						<a class="text primary name" href="{{.Owner.HomeLink}}">{{.Owner.Name}}</a>/
						{{end}}
						<a class="text primary name" href="{{.Link}}">{{.Name}}</a>
						<span class="label-list">
							{{if .IsArchived}}
								<span class="ui basic label">{{ctx.Locale.Tr "repo.desc.archived"}}</span>
							{{end}}
							{{if .IsPrivate}}
								<span class="ui basic label">{{ctx.Locale.Tr "repo.desc.private"}}</span>
							{{else}}
								{{if .Owner.Visibility.IsPrivate}}
									<span class="ui basic label">{{ctx.Locale.Tr "repo.desc.internal"}}</span>
								{{end}}
							{{end}}
							{{if .IsTemplate}}
								<span class="ui basic label">{{ctx.Locale.Tr "repo.desc.template"}}</span>
							{{end}}
							{{if eq .ObjectFormatName "sha256"}}
								<span class="ui basic label">{{ctx.Locale.Tr "repo.desc.sha256"}}</span>
							{{end}}
						</span>
							<!-- DCS Customizations -->
							{{if .RepoDM}}
								{{if eq .RepoDM.MetadataType "rc"}}
									{{template "shared/healthcheck_badge" (dict
										"RepoLink" .Link
										"Severity" .RepoDM.HealthcheckSeverity
										"OwnerName" .OwnerName
										"RepoName" .Name
										"Ref" .RepoDM.Ref
									)}}
								{{end}}
								{{if .LatestProdDM}}
									<a href="{{.Link}}/releases/tag/{{.LatestProdDM.Ref | PathEscapeSegments}}" rel="nofollow">
										<button class="ui green label compact icon button" data-tooltip-content="Catalog: Production" aria-label="Catalog: Production">
											{{.LatestProdDM.Ref}}
										</button>
									</a>
								{{end}}
								{{if .LatestPreprodDM}}
									<a href="{{.Link}}/releases/tag/{{.LatestPreprodDM.Ref | PathEscapeSegments}}" rel="nofollow">
										<button class="ui orange label compact icon button" data-tooltip-content="Catalog: Pre-Production" aria-label="Catalog: Production">
											{{.LatestPreprodDM.Ref}}
										</button>
									</a>
								{{end}}
							{{end}}
							<!-- END DCS Customizations -->
					</div>
					<div class="flex-item-trailing">
						<!-- DCS Customizations -->
						{{if .RepoDM}}
							{{if .RepoDM.Language}}
							<a class="muted" href="{{$.Link}}?sort={{$.SortType}}&q=lang%3A{{.RepoDM.Language}}" data-tooltip-content="{{.RepoDM.LanguageTitle}} ({{.RepoDM.Language}}, {{.RepoDM.LanguageDirection}})">
								<span class="tx-flex tw-items-center tw-mr-2"><i class="color-icon tw-mr-2" style="background-color: {{GetColorFromString .RepoDM.Language}}"></i>{{.RepoDM.Language}}</span>
							</a>
							{{end}}
							{{if .RepoDM.Subject}}
							<a class="muted" href="{{$.Link}}?sort={{$.SortType}}&q=subject%3A{{.RepoDM.Subject}}" data-tooltip-content="Abbreviation: {{.RepoDM.Abbreviation}}">
								<span class="tx-flex tw-items-center tw-mr-2"><i class="color-icon tw-mr-2" style="background-color: {{GetColorFromString .RepoDM.Subject}}"></i>{{.RepoDM.Subject}}</span>
							</a>
							{{end}}
							{{if and .RepoDM.MetadataType .RepoDM.MetadataVersion}}
							<a class="muted" href="?sort={{$.SortType}}&q=metadata_type%3A{{.RepoDM.MetadataType}}" data-tooltip-content="{{ctx.Locale.Tr "repo.metadata.metadata_type"}}: {{.RepoDM.MetadataTypeTitle}} ({{.RepoDM.MetadataType}} {{.RepoDM.MetadataVersion}})">
								<img src="{{AssetUrlPrefix}}/img/dcs/{{.RepoDM.MetadataTypeIcon}}" style="height:16px;vertical-align:middle" />
									{{.RepoDM.MetadataType}} {{.RepoDM.MetadataVersion}}
							</a>
							{{end}}
						{{end}}
						<!-- END DCS Customizations -->
						{{if not $.DisableStars}}
							<a class="flex-text-inline" href="{{.Link}}/stars">
								<span class="tw-contents" aria-label="{{ctx.Locale.Tr "repo.stars"}}">{{svg "octicon-star" 16}}</span>
								<span {{if ge .NumStars 1000}}data-tooltip-content="{{.NumStars}}"{{end}}>{{CountFmt .NumStars}}</span>
							</a>
						{{end}}
						<a class="flex-text-inline" href="{{.Link}}/forks">
							<span class="tw-contents" aria-label="{{ctx.Locale.Tr "repo.forks"}}">{{svg "octicon-git-branch" 16}}</span>
							<span {{if ge .NumForks 1000}}data-tooltip-content="{{.NumForks}}"{{end}}>{{CountFmt .NumForks}}</span>
						</a>
					</div>
				</div>
				{{$description := .DescriptionHTML ctx}}
				{{if $description}}
					<div class="flex-item-body">{{$description}}</div>
				{{end}}
				{{if .Topics}}
					<div class="label-list">
					{{range .Topics}}
						{{if ne . ""}}<a class="ui label" href="{{AppSubUrl}}/explore/repos?q=topic%3A{{.}}">{{.}}</a>{{end}}
					{{end}}
					</div>
				{{end}}
				<div class="flex-item-body">{{ctx.Locale.Tr "org.repo_updated"}} {{DateUtils.TimeSince .UpdatedUnix}}</div>
			</div>
		</div>
	{{else}}
	<div>
		{{ctx.Locale.Tr "search.no_results"}}
	</div>
	{{end}}
</div>
